<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.medcare.views.login.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.medcare.views.signup.SignUpFragment"
        android:label="fragment_sign_up"
        tools:layout="@layout/fragment_sign_up" />
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.medcare.views.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_myMedicineFragment"
            app:destination="@id/myMedicineFragment" />
        <action
            android:id="@+id/action_homeFragment_to_medicationReminderFragment"
            app:destination="@id/medicationReminderFragment" />
        <action
            android:id="@+id/action_homeFragment_to_addNewReminderFragment"
            app:destination="@id/addNewReminderFragment" />
        <action
            android:id="@+id/action_homeFragment_to_reminderFragment"
            app:destination="@id/reminderFragment" />
        <action
            android:id="@+id/action_homeFragment_to_reminderHistoryFragment"
            app:destination="@id/reminderHistoryFragment" />
        <action
            android:id="@+id/action_homeFragment_to_connectRelativesFragment"
            app:destination="@id/connectRelativesFragment" />
        <action
            android:id="@+id/action_homeFragment_to_contactDoctorFragment"
            app:destination="@id/contactDoctorFragment" />
        <action
            android:id="@+id/action_homeFragment_to_settingListFragment"
            app:destination="@id/settingListFragment" />
        <action
            android:id="@+id/action_homeFragment_to_userListManagerFragment"
            app:destination="@id/userListManagerFragment" />
    </fragment>
    <fragment
        android:id="@+id/myMedicineFragment"
        android:name="com.example.medcare.views.my_medicine.medicine_list.MyMedicineFragment"
        android:label="fragment_my_medicine"
        tools:layout="@layout/fragment_my_medicine" >
        <action
            android:id="@+id/action_myMedicineFragment_to_medicineDetailFragment"
            app:destination="@id/medicineDetailFragment" />
        <action
            android:id="@+id/action_myMedicineFragment_to_addMedicineFragment"
            app:destination="@id/addMedicineFragment" />
    </fragment>
    <fragment
        android:id="@+id/medicineDetailFragment"
        android:name="com.example.medcare.views.my_medicine.medicine_detail.MedicineDetailFragment"
        android:label="MedicineDetailFragment"
        tools:layout="@layout/fragment_medicine_detail">
        <action
            android:id="@+id/action_medicineDetailFragment_to_addMedicineFragment"
            app:destination="@id/addMedicineFragment" />
    </fragment>
    <fragment
        android:id="@+id/addMedicineFragment"
        android:name="com.example.medcare.views.my_medicine.add_medicine.AddMedicineFragment"
        android:label="fragment_add_medicine"
        tools:layout="@layout/fragment_add_medicine" />
    <fragment
        android:id="@+id/medicationReminderFragment"
        android:name="com.example.medcare.views.pill_reminder.MedicationReminderFragment"
        android:label="fragment_medication_reminder"
        tools:layout="@layout/fragment_medication_reminder" >
        <action
            android:id="@+id/action_medicationReminderFragment_to_addNewReminderFragment"
            app:destination="@id/addNewReminderFragment" />
        <action
            android:id="@+id/action_medicationReminderFragment_to_reminderDetailFragment"
            app:destination="@id/reminderDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/addNewReminderFragment"
        android:name="com.example.medcare.views.pill_reminder.add_new_reminder.AddNewReminderFragment"
        android:label="fragment_add_new_reminder"
        tools:layout="@layout/fragment_add_new_reminder" >
        <action
            android:id="@+id/action_addNewReminderFragment_to_addFrequencyFragment"
            app:destination="@id/addFrequencyFragment" />
        <action
            android:id="@+id/action_addNewReminderFragment_to_selectMedicineFragment"
            app:destination="@id/selectMedicineFragment" />
    </fragment>
    <fragment
        android:id="@+id/addFrequencyFragment"
        android:name="com.example.medcare.views.pill_reminder.add_new_reminder.add_frequency.AddFrequencyFragment"
        android:label="fragment_add_frequency"
        tools:layout="@layout/fragment_add_frequency" />
    <fragment
        android:id="@+id/reminderFragment"
        android:name="com.example.medcare.views.pill_reminder.add_new_reminder.reminder.ReminderFragment"
        android:label="fragment_reminder"
        tools:layout="@layout/fragment_reminder" />
    <fragment
        android:id="@+id/selectMedicineFragment"
        android:name="com.example.medcare.views.pill_reminder.add_new_reminder.select_medicines.SelectMedicineFragment"
        android:label="fragment_select_medicine"
        tools:layout="@layout/fragment_select_medicine" />
    <fragment
        android:id="@+id/reminderDetailFragment"
        android:name="com.example.medcare.views.pill_reminder.reminder_detail.ReminderDetailFragment"
        android:label="fragment_reminder_detail"
        tools:layout="@layout/fragment_reminder_detail" >
        <action
            android:id="@+id/action_reminderDetailFragment_to_medicineDetailFragment"
            app:destination="@id/medicineDetailFragment" />
        <action
            android:id="@+id/action_reminderDetailFragment_to_addNewReminderFragment"
            app:destination="@id/addNewReminderFragment" />
    </fragment>
    <fragment
        android:id="@+id/reminderHistoryFragment"
        android:name="com.example.medcare.views.reminder_history.reminder_history_list.ReminderHistoryFragment"
        android:label="fragment_reminder_history"
        tools:layout="@layout/fragment_reminder_history" >
        <action
            android:id="@+id/action_reminderHistoryFragment_to_reminderHistoryDetailFragment"
            app:destination="@id/reminderHistoryDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/reminderHistoryDetailFragment"
        android:name="com.example.medcare.views.reminder_history.reminder_history_detail.ReminderHistoryDetailFragment"
        android:label="fragment_reminder_history_detail"
        tools:layout="@layout/fragment_reminder_history_detail" />
    <fragment
        android:id="@+id/connectRelativesFragment"
        android:name="com.example.medcare.views.connect_relatives.connect_relatives_list.ConnectRelativesFragment"
        android:label="fragment_connect_relatives"
        tools:layout="@layout/fragment_connect_relatives" >
        <action
            android:id="@+id/action_connectRelativesFragment_to_relativeReminderHistoryFragment"
            app:destination="@id/relativeReminderHistoryFragment" />
        <action
            android:id="@+id/action_connectRelativesFragment_to_relativeRequestAddFragment"
            app:destination="@id/relativeRequestAddFragment" />
    </fragment>
    <fragment
        android:id="@+id/relativeReminderHistoryFragment"
        android:name="com.example.medcare.views.connect_relatives.relative_reminder_history.RelativeReminderHistoryFragment"
        android:label="fragment_relative_reminder_history"
        tools:layout="@layout/fragment_relative_reminder_history" />
    <fragment
        android:id="@+id/relativeRequestAddFragment"
        android:name="com.example.medcare.views.connect_relatives.relative_request_add.RelativeRequestAddFragment"
        android:label="fragment_relative_request_add"
        tools:layout="@layout/fragment_relative_request_add" >
        <action
            android:id="@+id/action_relativeRequestAddFragment_to_relativeReminderDetailFragment"
            app:destination="@id/relativeReminderDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/relativeReminderDetailFragment"
        android:name="com.example.medcare.views.connect_relatives.relative_reminder_detail.RelativeReminderDetailFragment"
        android:label="fragment_relative_reminder_detail"
        tools:layout="@layout/fragment_relative_reminder_detail" />
    <fragment
        android:id="@+id/contactDoctorFragment"
        android:name="com.example.medcare.views.health_advice.contact_doctor.ContactDoctorFragment"
        android:label="fragment_contact_doctor"
        tools:layout="@layout/fragment_contact_doctor" >
        <action
            android:id="@+id/action_contactDoctorFragment_to_chatDoctorListFragment"
            app:destination="@id/chatDoctorListFragment" />
        <action
            android:id="@+id/action_contactDoctorFragment_to_chatDoctorDetailFragment"
            app:destination="@id/chatDoctorDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/chatDoctorListFragment"
        android:name="com.example.medcare.views.health_advice.chat_doctor.ChatDoctorListFragment"
        android:label="fragment_chat_doctor_list"
        tools:layout="@layout/fragment_chat_doctor_list" >
        <action
            android:id="@+id/action_chatDoctorListFragment_to_chatDoctorDetailFragment"
            app:destination="@id/chatDoctorDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/chatDoctorDetailFragment"
        android:name="com.example.medcare.views.health_advice.chat_doctor_detail.ChatDoctorDetailFragment"
        android:label="fragment_chat_doctor_detail"
        tools:layout="@layout/fragment_chat_doctor_detail" />
    <fragment
        android:id="@+id/settingListFragment"
        android:name="com.example.medcare.views.setting.setting_list.SettingListFragment"
        android:label="fragment_setting_list"
        tools:layout="@layout/fragment_setting_list" />
    <fragment
        android:id="@+id/userListManagerFragment"
        android:name="com.example.medcare.views.user_manager.user_list.UserListManagerFragment"
        android:label="fragment_user_list_manager"
        tools:layout="@layout/fragment_user_list_manager" >
        <action
            android:id="@+id/action_userListManagerFragment_to_userDetailFragment"
            app:destination="@id/userDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/userDetailFragment"
        android:name="com.example.medcare.views.user_manager.user_detail.UserDetailFragment"
        android:label="fragment_user_detail"
        tools:layout="@layout/fragment_user_detail" />
</navigation>